{
  "name": "@joshoy/quartz-cron-parser",
  "version": "1.0.3",
  "description": "A quartz cron expression parser",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/src/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/src/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": "https://github.com/JoshOY/quartz-cron-parser.git",
  "author": "Josh Ouyang <me@joshoy.org>",
  "packageManager": "yarn@1.22.22",
  "keywords": [
    "quartz-cron",
    "quartz",
    "cron-expression",
    "parser",
    "validator"
  ],
  "files": [
    "CHANGELOG.md",
    "dist/types/src/grammar.d.ts",
    "dist/types/src/index.d.cts",
    "dist/types/src/index.d.mts",
    "dist/types/src/index.d.ts",
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.min.js",
    "dist/index.min.js.map"
  ],
  "license": "MIT",
  "scripts": {
    "gen-parser": "nearleyc ./src/grammar.ne -o ./src/grammar.js",
    "build": "npm run gen-parser && rimraf ./dist && rollup -c rollup.config.mjs && node ./scripts/create-module-declarations.mjs",
    "release": "npm run build && npm publish --access=public --registry=https://registry.npmjs.org",
    "test": "jest",
    "test:exports": "node test/exports.cjs && node test/exports.mjs",
    "test:package": "node test/package.cjs",
    "test:types": "attw --pack . --format table --no-emoji --no-color"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/nearley": "^2.11.5",
    "jest": "^30.5.1",
    "moo": "^0.5.3",
    "nearley": "^2.20.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
